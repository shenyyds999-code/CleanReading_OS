{
  "name": "generated-desktop-app",
  "version": "1.0.0",
  "description": "WebView 桌面壳 — {{APP_NAME}}",
  "main": "main.js",
  "author": "WebView Builder",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "{{APP_ID}}",
    "productName": "{{APP_NAME}}",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
